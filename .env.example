# Development-only example values. Never commit real secrets.
RSVQA_WEB_PORT=8088
RSVQA_DATABASE_PASSWORD=rsvqa_dev_only
RSVQA_POSTGRES_PORT=15432
RSVQA_REDIS_PORT=16379
RSVQA_MODEL_MODE=mock
RSVQA_MOCK_LATENCY_MS=0
RSVQA_MODEL_RELEASES_DIR=./model-releases
RSVQA_RELEASE_MANIFEST=
RSVQA_RUNTIME_ENTRYPOINT=
RSVQA_DEMO_AUTH=true
RSVQA_SPRING_PROFILE=demo
RSVQA_KNOWLEDGE_SERVICE_URL=http://knowledge-service:8010
RSVQA_KNOWLEDGE_INDEX_VERSION=rsvqa-knowledge-v2
RSVQA_MILVUS_COLLECTION=rsvqa_knowledge_v2
RSVQA_BGE_MODEL=BAAI/bge-small-zh-v1.5
RSVQA_MCP_CLIENT_ENABLED=false
RSVQA_MCP_REMOTE_URL=http://host.docker.internal:18080
RSVQA_MCP_REMOTE_ENDPOINT=/mcp
RSVQA_MCP_ENABLED=false
RSVQA_MCP_BEARER_TOKEN=
RSVQA_MCP_PRINCIPAL=
RSVQA_BATCH_RECOVERY_ENABLED=true
RSVQA_BATCH_LEASE_DURATION=PT10M
RSVQA_BATCH_RECOVERY_INTERVAL=PT30S
# Gemini relay (OpenAI-compatible). Leave every value empty here; put real values
# in the untracked .env only. Vision stays UNCONFIGURED until a model that has
# been verified to accept image input is named explicitly.
RSVQA_GEMINI_ENABLED=false
RSVQA_GEMINI_BASE_URL=
RSVQA_GEMINI_API_KEY=
RSVQA_GEMINI_COMPLETIONS_PATH=/v1/chat/completions
RSVQA_GEMINI_AGENT_ENABLED=false
RSVQA_GEMINI_AGENT_MODEL=gemini-3.6-flash
RSVQA_GEMINI_VISION_ENABLED=false
RSVQA_GEMINI_VISION_MODEL=
# Local-development-only MinIO defaults; replace through an untracked environment file outside a demo.
RSVQA_MINIO_USER=minioadmin
RSVQA_MINIO_PASSWORD=minioadmin
