FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=5
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
WORKDIR /opt/rsvqa/model-service
COPY pyproject.toml requirements-real.txt ./
RUN pip install --index-url "${PYTORCH_INDEX_URL}" --timeout 180 --retries 5 "torch>=2.2,<3.0" \
    && pip install --timeout 180 --retries 5 -r requirements-real.txt
COPY app ./app
RUN pip install --no-deps .
RUN addgroup --system rsvqa && adduser --system --ingroup rsvqa rsvqa \
    && chown -R rsvqa:rsvqa /opt/rsvqa
USER rsvqa
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
